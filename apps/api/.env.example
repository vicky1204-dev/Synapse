# Synapse API — Environment Variables
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# All variables are validated at startup via src/config/env.ts.
# Missing required variables will abort startup.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/synapse
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
# Generate secure random strings for production (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
